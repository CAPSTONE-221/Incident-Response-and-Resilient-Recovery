# Ignore large raw dataset archives and dumps
*.pcap
*.pcapng
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.tgz
*.7z
*.raw
*.vmdk
*.iso
*.parquet

# Ignore giant raw CSV / text dumps exceeding GitHub limits
# Keep schemas, samples, scripts, and markdown documentation
*.dump
data/raw/
public/*/*.csv
public/*/*.txt
public/*/# Large generated or downloaded files (> 50 MB)
enterprise-attack.json
*.json.gz
*.tar.bz2


# Allow small sample files and configs
!sample_*.csv
!sample_*.json
!schema_*.json
!requirements.txt
